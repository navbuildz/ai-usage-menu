// aiusagemenu.com: static site served from Cloudflare Workers assets (no Worker code).
// Build first: `npm run build` writes ../app/build/site-dist. Deploy: `npx wrangler deploy`.
{
  "name": "aiusagemenu-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../app/build/site-dist",
    // Canonicals, the sitemap and internal links have no trailing slash.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "aiusagemenu.com", "custom_domain": true },
    { "pattern": "www.aiusagemenu.com", "custom_domain": true }
  ]
}
