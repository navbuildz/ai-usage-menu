---
import './site.css';
import HeaderNav from './HeaderNav.astro';
import TrustCard from './TrustCard.astro';
import Theme from './Theme.astro';
import {base,labels,pathFor,repo} from '../data/shared.mjs';
import darkLogo from '../../../brand/02-logos/lockups/horizontal-dark-background.svg?url';
import lightLogo from '../../../brand/02-logos/lockups/horizontal-light-background.svg?url';
import config from '../data/repo.json';
const {id,title,meta,graph=[],art,notFound=false}=Astro.props;
const canonical=base+(notFound?'/404':pathFor(id));
const og=base+'/art/og-'+id+'.png';
const homeCapture=id==='home' && !notFound;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={meta}/>{!notFound && <link rel="canonical" href={canonical}/>}<link rel="icon" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
{notFound && <meta name="robots" content="noindex"/>}
<meta property="og:type" content={id==='claude-usage-limits'?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={meta}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="AI Usage Menu"/><meta property="og:image" content={og}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={meta}/><meta name="twitter:image" content={og}/>
{homeCapture && ['dark','light'].map(mode=>[['mobile','(max-width: 770px)'],['hero','(min-width: 771px)']].map(([stem,width])=><link rel="preload" as="image" type="image/avif" media={width+' and (prefers-color-scheme: '+mode+')'} href={'/art/retina/'+stem+'-'+mode+'.avif'} fetchpriority="high"/>))}
{art && !homeCapture && !['claude-usage-limits','codex-usage'].includes(id) && <link rel="preload" as="image" type="image/avif" href={'/art/'+art+'.avif'} imagesrcset={[480,800,1200].map(w=>'/art/'+art+(w===1200?'':'-'+w)+'.avif '+w+'w').join(', ')} imagesizes="(max-width: 680px) 100vw, (max-width: 1000px) 72vw, 700px" fetchpriority="high"/>}
{graph.length>0 && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>}
<script is:inline src="/theme.js"></script></head>
<body><a class="skip" href="#content">Skip to content</a>
<span id="mast-sentinel" aria-hidden="true"></span><header class="mast"><div class="wrap navline"><a class="brand" href="/" aria-label="AI Usage Menu home"><img class="on-dark" src={darkLogo} width="186" height="40" alt="AI Usage Menu"/><img class="on-light" src={lightLogo} width="186" height="40" alt="AI Usage Menu"/></a><HeaderNav id={id}/><details class="nav-disclosure"><summary aria-label="Navigation menu"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg></summary><HeaderNav id={id} mobile/></details><div class="header-actions"><Theme/><a class="nav-download" aria-current={id==='download'?'page':undefined} href="/download"><span>Download</span><span class="for-mac"> for Mac</span> ↓</a></div></div></header>
<main class="wrap" id="content">{id!=='home' && <nav class="crumb" aria-label="Breadcrumb"><a href="/">AI Usage Menu</a> <span aria-hidden="true">/</span> <span>{notFound?'Page not found':labels[id]}</span></nav>}<slot/></main>
<footer><div class="wrap"><div class="footgrid"><div><a href="/" class="brand"><img class="on-dark" src={darkLogo} width="186" height="40" alt="AI Usage Menu"/><img class="on-light" src={lightLogo} width="186" height="40" alt="AI Usage Menu"/></a><a href="https://typefire.app">From the makers of TypeFire ↗</a></div><nav aria-label="Site pages">{Object.entries(labels).map(([key,label])=><a href={pathFor(key)}>{label}</a>)}</nav><nav aria-label="Project"><strong>Open source, MIT</strong><span>Free for macOS 13 and later.</span><a href={config.owner==='OWNER'?'/open-source':repo}>GitHub project</a>{config.owner!=='OWNER' && ['README.md','CONTRIBUTING.md','CODE_OF_CONDUCT.md','SECURITY.md','LICENSE'].map((name,i)=><a href={repo+'/blob/'+config.branch+'/'+name}>{['Readme','Contributing','Code of conduct','Security','MIT license'][i]}</a>)}</nav></div><TrustCard compact/><p class="legal">AI Usage Menu is not affiliated with Anthropic or OpenAI. Claude is a trademark of Anthropic, PBC. Codex and ChatGPT are trademarks of OpenAI.</p></div></footer>

</body></html>
