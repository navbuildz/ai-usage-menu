---
import '../styles/aum.css';
import HeaderNav from './HeaderNav.astro';
import Theme from './Theme.astro';
import Icon from './Icon.astro';
import {base,labels,pathFor} from '../data/shared.mjs';
import darkLogo from '../../../brand/02-logos/lockups/horizontal-dark-background.svg?url';
import lightLogo from '../../../brand/02-logos/lockups/horizontal-light-background.svg?url';
import mark from '../../../brand/02-logos/mark/mark-gradient.svg?url';
import ProviderLogo from './ProviderLogo.astro';
const {id,title,meta,graph=[],art,notFound=false}=Astro.props;
const canonical=base+(notFound?'/404':pathFor(id));
const og=base+'/art/og-'+id+'.png';
const cols=[
  ['Product',[['/download','Download'],['/privacy','Privacy & Legal'],['/open-source','Open source'],['/compare','Compare trackers']]],
  ['Guides',[['/claude-usage-limits','Claude usage limits'],['/claude-code-usage','Claude Code usage'],['/codex-usage','Codex usage']]],
  ['Project',[['/open-source#read-the-code','Read the code'],['/open-source#changelog','Changelog'],['/privacy#legal-notices','MIT license']]],
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={meta}/>{!notFound && <link rel="canonical" href={canonical}/>}<link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
{notFound && <meta name="robots" content="noindex"/>}
<meta name="theme-color" content="#0b0e20" media="(prefers-color-scheme: dark)"/><meta name="theme-color" content="#f6f7fd" media="(prefers-color-scheme: light)"/>
<meta property="og:type" content={id==='claude-usage-limits'?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={meta}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="AI Usage Menu"/><meta property="og:image" content={og}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={meta}/><meta name="twitter:image" content={og}/>
{art && <link rel="preload" as="image" type="image/avif" href={'/art/'+art+'.avif'} imagesrcset={[480,800,1200].map(w=>'/art/'+art+(w===1200?'':'-'+w)+'.avif '+w+'w').join(', ')} imagesizes="(max-width: 960px) 100vw, 640px" fetchpriority="high"/>}
{graph.length>0 && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>}
<script is:inline src="/theme.js"></script><script is:inline defer src="/site.js"></script><script is:inline defer src="/ga.js"></script><script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BQD441VNTH"></script></head>
<body><a class="skip" href="#content">Skip to content</a>
<span id="mast-sentinel" aria-hidden="true"></span>
<header class="mast"><div class="wrap navline">
  <a class="brand brand-live" href="/" aria-label="AI Usage Menu home"><img class="brand-mark" src={mark} width="34" height="34" alt="AI Usage Menu"/><span class="brand-word" aria-hidden="true">AI Usage Menu</span></a>
  <HeaderNav id={id}/>
  <details class="nav-disclosure"><summary aria-label="Navigation menu"><Icon name="list" class="ic-open"/><Icon name="x" class="ic-close"/></summary><HeaderNav id={id} mobile/></details>
  <a class="btn btn-primary btn-sm nav-cta" aria-current={id==='download'?'page':undefined} href="/download"><span>Download<span class="lbl-long"> for Mac</span></span><Icon name="download-simple"/></a>
</div></header>
<main id="content"><div class="wrap">{id!=='home' && <nav class="crumb" aria-label="Breadcrumb"><a href="/">AI Usage Menu</a><Icon name="caret-down" class="crumb-sep"/><span>{notFound?'Page not found':labels[id]}</span></nav>}<slot/></div></main>
<footer class="site">
  <div class="wrap foot-cols">
    <div class="foot-id"><a href="/" class="brand"><img class="on-dark" src={darkLogo} width="186" height="40" alt="AI Usage Menu"/><img class="on-light" src={lightLogo} width="186" height="40" alt="AI Usage Menu"/></a><p>Your Claude Code and Codex limits in the menu bar and Dock. Free, open source, and nothing to paste.</p><a class="arrow-link" href="https://typefire.app">From the makers of TypeFire<Icon name="arrow-up-right"/></a></div>
    {cols.map(([h,links])=><nav aria-label={h}><h2>{h}</h2><ul>{links.map(([href,label])=><li><a href={href}>{label}</a></li>)}</ul></nav>)}
    <nav aria-label="Feedback"><h2>Feedback</h2><ul><li><a href="https://github.com/navbuildz/ai-usage-menu/issues/new?template=bug.yml">Report a bug</a></li><li><a href="https://github.com/navbuildz/ai-usage-menu/issues/new?template=feature.yml">Request a feature</a></li><li><a href="https://github.com/navbuildz/ai-usage-menu/discussions">Ask a question</a></li><li><a href="https://github.com/navbuildz/ai-usage-menu">GitHub</a></li></ul></nav>
  </div>
  <div class="foot-bar"><span class="glow" aria-hidden="true"></span><div class="wrap fb-in">
    <div class="fb-tag"><img src={mark} width="28" height="28" alt="AI Usage Menu"/><span>Know your limits before you hit them.</span></div>
    <div class="fb-glyphs" role="group" aria-label="Supported tools"><span class="glyph"><ProviderLogo id="claude" label/></span><span class="glyph"><ProviderLogo id="codex" label/></span></div>
    <Theme/>
    <p class="legal"><span>AI Usage Menu is not affiliated with Anthropic or OpenAI. Claude is a trademark of Anthropic, PBC. Codex and ChatGPT are trademarks of OpenAI.</span><span>Free and MIT licensed.</span></p>
  </div></div>
</footer>
</body></html>
