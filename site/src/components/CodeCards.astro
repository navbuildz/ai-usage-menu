---
import {Code} from 'astro:components';
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import config from '../data/repo.json';
import {repo} from '../data/shared.mjs';
import Icon from './Icon.astro';
const {variant='all'}=Astro.props;
const specs=[
 ['claude','Claude Code reader','app/Sources/ClaudeCodeProvider.swift','func read() async -> ProviderSnapshot',9,'Runs the local /usage command and parses its output.'],
 ['codex','Codex log reader','app/Sources/CodexProvider.swift','static func latest(in file:',11,'Reads the newest session from the end of its local log.'],
 ['account','Codex account mode','app/Sources/CodexProvider.swift','static func authMode(in file:',7,'Decodes the account mode to identify sign-ins with plan windows.'],
 ['updates','Optional updater','app/Sources/Updater/UpdateService.swift','private func updater() -> SPUUpdater',8,'Creates the updater only when an update check is requested.'],
 ['network','Network source test','app/Tests/ProviderTests.swift','func testNoNetworkCodeOutsideUpdater()',8,'Checks app sources for network APIs outside the updater.']
] as const;
const selected=specs.filter(([id])=>variant==='all'?id!=='account':(variant==='verify'?['account','network']:['updates','network']).includes(id));
const cards=await Promise.all(selected.map(async ([id,title,path,signature,count,description])=>{
 const file=await readFile(resolve('..',path),'utf8');
 const lines=file.split(/\r?\n/),start=lines.findIndex(line=>line.includes(signature));
 if(start<0)throw new Error('Missing source signature in '+path+': '+signature);
 const excerpt=lines.slice(start,start+count).join('\n');
 return {id,title,path,description,excerpt,first:start+1,url:repo+'/blob/'+config.branch+'/'+path+'#L'+(start+1)+'-L'+(start+count)};
}));
const heading=variant==='all'?'Read the code that touches your data':variant==='verify'?'Inspect the local reader and network test':'Inspect the updater and its network boundary';
const anchor=heading.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
---
<section class="source-section" id={variant==='all'?'read-the-code':anchor} aria-labelledby={anchor+'-h'}>
<h2 id={anchor+'-h'}>{heading}</h2>
<div class="network-statement" data-reveal><span class="ic-tile"><Icon name="wifi-slash" duo/></span><p>The app makes no network requests except the update check you turn on.</p></div>
<div class="source-grid" data-reveal-group>{cards.map(card=><article id={'source-'+card.id} class="source-card">
<header><span class="ic-tile sm"><Icon name="file-code"/></span><h3>{card.title}</h3></header>
<div class="source-path" title={card.path}>{card.path}</div>
<p>{card.description}</p><div class="source-sample" style={'--source-first: '+(card.first-1)}><Code code={card.excerpt} lang="swift" theme="github-dark" /></div>
{config.owner!=='OWNER' && <a class="arrow-link" href={card.url}>View on GitHub<Icon name="arrow-up-right"/></a>}
</article>)}</div></section>
