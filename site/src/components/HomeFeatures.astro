---
import Capture from './Capture.astro';
import Glance from './Glance.astro';
import Art from './Art.astro';
const {sections}=Astro.props;
const [menu,activity,dock,pair,open]=sections;
---
<section class="glance-section"><div><h2>{menu[0]}</h2><p>{menu[1]}</p><a href="/claude-usage-limits">Claude usage limits</a></div><Glance/></section>
<div class="product-bento">
<section class="tile tile-dock"><div><h2>{dock[0]}</h2><p>{dock[1]}</p></div><div class="tile-trio">{[30,72,94].map(n=><picture><source type="image/avif" srcset={'/art/retina/dock-'+n+'.avif'}/><source type="image/webp" srcset={'/art/retina/dock-'+n+'.webp'}/><img width="224" height="224" alt={'Dock gauge showing '+n+' percent used'} src={'/art/retina/dock-'+n+'.png'} loading="lazy"/></picture>)}</div></section>
<section class="tile tile-activity"><div><h2>{activity[0]}</h2><p>{activity[1]}</p><a href="/claude-code-usage">Check Claude Code usage</a></div><Capture name="activity" width="760" height="710" alt="Claude activity breakdown with request counts, ranked sessions and context files"/></section>
<section class="tile tile-pair"><div><h2>{pair[0]}</h2><p>{pair[1]}</p><a href="/codex-usage">Check Codex usage</a></div><div class="provider-pair"><Capture name="claude" width="760" height="590" alt="Claude Code tab showing 30 percent session and 57 percent weekly usage"/><Capture name="codex" width="760" height="640" alt="Codex tab showing the session, weekly limit and last activity time"/></div></section>
<section class="tile tile-private"><h2>Private by design</h2><a href="/privacy">Claude usage tracker privacy</a><img src="/art/privacy.svg" loading="lazy" width="1200" height="800" alt="Diagram of the local Claude Code and Codex data paths into AI Usage Menu"/></section>
<section class="tile tile-open"><h2>{open[0]}</h2><p>{open[1]}</p><a href="/open-source">Open source Claude usage tracker</a><Art name="code"/></section>
<section class="tile tile-tokens"><div><h2>Zero tokens to check</h2><p>Open the existing usage readout without sending a prompt to a model.</p><a href="/claude-code-usage">Claude Code /usage command</a></div><Art name="terminal"/></section>
</div>
