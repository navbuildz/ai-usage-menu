---
import config from '../data/repo.json';
import {repo, stats} from '../data/shared.mjs';
const {compact=false}=Astro.props;
const publicRepo=config.owner!=='OWNER';
const entries=stats?[['Stars',stats.stars],['Forks',stats.forks],['Contributors',stats.contributors],['Latest release',stats.releases[0]?.tag],['License',stats.license]].filter(([,value])=>value!==undefined):[];
---
<aside class:list={['repo-trust',{compact}]} aria-label={compact?'Repository summary':'Project repository'}>
<div><span class="git-mark" aria-hidden="true">⑂</span><strong>Open source, MIT</strong></div>
{stats && <><dl>{entries.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><small>As of {stats.asOf}</small></>}
<a href={publicRepo?repo+'/blob/'+config.branch+'/app/Sources/ClaudeCodeProvider.swift':'/open-source#read-the-code'}>Read the code <span aria-hidden="true">↗</span></a>
</aside>
<style>
.repo-trust{display:flex;align-items:center;flex-wrap:wrap;gap:1.1rem 2rem;border-block:1px solid var(--line);padding:1.3rem 0}.repo-trust>div{display:flex;align-items:center;gap:.6rem}.git-mark{display:inline-grid;place-items:center;width:2rem;height:2rem;border-radius:.6rem;background:var(--raised);font-size:1.4rem}.repo-trust strong{font-family:'Inter Variable',sans-serif}.repo-trust dl{display:flex;flex-wrap:wrap;gap:1rem;margin:0}.repo-trust dd{margin:0;font-weight:700}.repo-trust dt,.repo-trust small{font-size:.8rem;color:var(--muted)}.repo-trust.compact{border:0;padding:0;gap:.5rem 1rem;font-size:.9rem}.repo-trust.compact dl{display:none}
</style>
