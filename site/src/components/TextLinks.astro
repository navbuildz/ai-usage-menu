---
import pages from '../data/content.json';
const {text,id}=Astro.props;
const phrases=Object.entries(pages).filter(([key])=>key!==id).flatMap(([key,page])=>(page.keywords??[]).map(phrase=>({key,phrase}))).sort((a,b)=>b.phrase.length-a.phrase.length);
const owners=new Map(phrases.map(({key,phrase})=>[phrase,key]));
const pattern=phrases.map(({phrase})=>phrase.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('|');
const parts=pattern?text.split(new RegExp('\\b('+pattern+')\\b','gi')):[text];
---
{parts.map((part,index)=>index%2===1?<a href={owners.get(part.toLowerCase())==='home'?'/':'/'+owners.get(part.toLowerCase())}>{part}</a>:part)}
