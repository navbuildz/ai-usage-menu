---
import Icon from './Icon.astro';
const modes=[['system','desktop','Auto'],['light','sun','Light'],['dark','moon','Dark']];
---
<div class="appearance" role="group" aria-label="Color theme">{modes.map(([mode,icon,label])=><button type="button" data-mode={mode} aria-label={label+' theme'} aria-pressed={mode==='system'?'true':'false'}><Icon name={icon}/><span>{label}</span></button>)}</div>
