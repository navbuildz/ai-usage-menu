---
import release from '../data/release.json';
import {facts} from '../data/facts.mjs';
import Layout from '../components/Layout.astro';
import Home from '../components/Home.astro';
import Reader from '../components/Reader.astro';
import pages from '../data/content.json';
import comparison from '../data/compare.json';
import config from '../data/repo.json';
import {repo,base,pathFor,labels,feature,dates} from '../data/shared.mjs';
export function getStaticPaths(){ return Object.keys(pages).map(id=>({params:{page:id==='home'?undefined:id},props:{id}})); }
const {id}=Astro.props,p=pages[id],url=base+pathFor(id),home=id==='home',date=dates[id];
const appID=base+'/#software',orgID=base+'/#organization';
const graph=[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:base+'/'},...home?[]:[{'@type':'ListItem',position:2,name:labels[id],item:url}]]}];
const publisher={'@type':'Organization',name:'TypeFire',url:'https://typefire.app'};
const publicRepo=config.owner!=='OWNER';
const guide=['claude-code-usage','codex-usage','claude-usage-limits'].includes(id);
if(home || id==='download') graph.push({'@type':'SoftwareApplication','@id':appID,name:'AI Usage Menu',description:facts.Product,url:base+'/',operatingSystem:'macOS 13 or later',applicationCategory:'DeveloperApplication',offers:{'@type':'Offer',price:0,priceCurrency:'USD'},license:'https://opensource.org/licenses/MIT',downloadUrl:config.dmg||base+'/download',...(release.softwareVersion&&{softwareVersion:release.softwareVersion}),...(release.fileSize&&{fileSize:release.fileSize}),...(publicRepo&&{sameAs:repo}),dateModified:date,publisher,screenshot:['hero-dark','trio','breakdown','pair'].map(n=>base+'/art/'+n+'.png'),isAccessibleForFree:true,featureList:Object.values(facts)});
if(home)graph.push({...publisher,'@id':orgID},{'@type':'WebSite',name:'AI Usage Menu',description:p.meta,url:base,dateModified:date});
if(id==='open-source') graph.push({'@type':'SoftwareSourceCode',name:'AI Usage Menu',url,description:p.answer,...(publicRepo&&{codeRepository:repo}),programmingLanguage:'Swift',license:'https://opensource.org/licenses/MIT',runtimePlatform:'macOS',dateModified:date});
if(id==='privacy')graph.push({'@type':'WebPage',name:p.h1,description:p.answer,url,about:{'@id':appID},dateModified:date});
if(id==='compare')graph.push({'@type':'ItemList',name:p.h1,url,dateModified:date,itemListElement:comparison.rows.map(([name],i)=>({'@type':'ListItem',position:i+1,name}))});
if(guide||id==='compare')graph.push({'@type':'Article',headline:p.h1,description:p.meta,url,datePublished:date,dateModified:date,author:publisher});
if(p.faqs.length)graph.push({'@type':'FAQPage',name:p.h1,url,mainEntity:p.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))});
const stepsName=({'claude-code-usage':'Check Claude Code usage','codex-usage':'Check Codex usage','claude-usage-limits':'How to check your Claude usage',download:'Install AI Usage Menu'})[id] || 'How it works in three steps';
if(!home && p.steps.length)graph.push({'@type':'HowTo',name:stepsName,url,description:p.meta,step:p.steps.map((text,i)=>({'@type':'HowToStep',position:i+1,text}))});
const sections=p.sections.filter(([heading])=>heading!==stepsName).filter(([heading])=>id!=='open-source'||!['Changelog','Read the code that touches your data','Install three ways'].includes(heading));
const dateLabel=new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeZone:'UTC'}).format(new Date(date));
---
<Layout id={id} title={p.title} meta={p.meta} graph={graph} art={undefined}>
{home ? <Home p={p} id={id} date={date} dateLabel={dateLabel}/> : <Reader p={p} id={id} date={date} dateLabel={dateLabel} stepsName={stepsName} sections={sections}/>}
</Layout>
